PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bashar_thikana
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Stripe listing-fee payments (dashboard.stripe.com > Developers > API keys). Use sk_test_/pk_test_ keys while testing.
STRIPE_SE_KEY=sk_test_replace_me
STRIPE_PUB_KEY=pk_test_replace_me
# Optional: signing secret of a webhook endpoint pointing at /api/payments/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Add later when you enable the real map/AI integrations:
# GOOGLE_MAPS_SERVER_API_KEY=
# OPENAI_API_KEY=
